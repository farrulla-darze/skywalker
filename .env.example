# ============================================================
# Skywalker environment configuration
# NEVER put real credentials in this file — it is committed.
# ============================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# --- Database (app state) ---
# Docker compose: postgresql+asyncpg://skywalker:skywalker@postgres:5432/skywalker
DATABASE_URL=sqlite+aiosqlite:///./skywalker.db

# --- Security ---
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CORS_ORIGINS=["http://localhost:5173","http://localhost:3001"]
ALLOW_ANONYMOUS_CHAT=true

# --- LLM ---
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL=openai:gpt-5-mini
# Non-reasoning model — reasoning models can stall for minutes on a guardrail call
GUARDRAIL_MODEL=openai:gpt-4.1-mini
GUARDRAILS_ENABLED=true
# Per-request LLM timeouts (seconds); OpenAI client retries twice on timeout
LLM_REQUEST_TIMEOUT_SECONDS=120
GUARDRAIL_TIMEOUT_SECONDS=30
# Hard cap on one Telegram turn (auto-raised to CONSULTATION_TIMEOUT_SECONDS + 120 if larger)
TELEGRAM_TURN_TIMEOUT_SECONDS=300

# --- Vector store (Qdrant, local via Docker) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=skywalker_kb
DEFAULT_NAMESPACE=getnet

# --- Knowledge graph (Neo4j, local via Docker) ---
GRAPH_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skywalker-graph

# --- Observability (optional) ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-skywalker-local
LANGFUSE_SECRET_KEY=sk-lf-skywalker-local
LANGFUSE_HOST=http://localhost:3000
